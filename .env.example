# Host port / listening address (use 127.0.0.1 behind a local reverse proxy).
WEBSITE_PORT=6660
WEBSITE_BIND=0.0.0.0

# Absolute paths are recommended on servers. This directory must already exist.
# Installer filenames are configured separately in config/site.json.
DOWNLOADS_DIR=/opt/fastaiapi-groups/juya-web/download

# PostgreSQL 为唯一业务数据库。restart.sh 首次运行会为留空密码生成随机值。
POSTGRES_USER=merchant
POSTGRES_DB=merchant
POSTGRES_PASSWORD=

# 首次启动必须配置；数据库中已有管理员后可移除。不要使用示例密码。
MERCHANT_ADMIN_USERNAME=platform_admin
MERCHANT_ADMIN_PASSWORD=
# HTTPS 部署保留 true；本机 HTTP 调试设为 false。
MERCHANT_SECURE_COOKIES=true
# 可选：固定商户后台来源，例如 https://home.fastaiapi.cloud（不要带结尾斜杠）。
MERCHANT_PUBLIC_ORIGIN=https://home.fastaiapi.cloud
