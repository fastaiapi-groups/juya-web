  {
    "id": "compat-grid",
    "title": "LTX四宫格",
    "format": "compatible",
    "note": "上传一张2×2四宫格图片，画面依次为左上、右上、左下、右下；不是四张独立参考图。",
    "body": {
      "model": "ltx-2.3-grid",
      "prompt": "按四幅画面的顺序，表现人物进入庭院、停下、转身、离开的过程。",
      "seconds": 4,
      "size": "512x512",
      "input_reference": "https://cdn.example.com/grid-2x2.jpg"
    }
  },
  {
    "id": "compat-avatar",
    "title": "LTX数字人配音",
    "format": "compatible",
    "note": "提供一张人物图和一段覆盖生成时长的完整配音；不是仅提供一小段音色样本。",
    "body": {
      "model": "ltx-2.3-avatar",
      "prompt": "人物正对镜头自然讲述，面部表情柔和。",
      "seconds": 5,
      "size": "576x1024",
      "input_reference": "https://cdn.example.com/presenter.jpg",
      "metadata": {
        "reference_audios": [
          "https://cdn.example.com/speech.mp3"
        ]
      }
    }
  },
  {
    "id": "compat-ltx-last",
    "title": "LTX X首尾帧",
    "format": "compatible",
    "note": "宽高按64对齐，此型号使用25fps；不要套用其他LTX变种的默认值。",
    "body": {
      "model": "ltx-2.3-x",
      "prompt": "从清晨的花园平稳移动到尾帧中的凉亭。",
      "seconds": 5,
      "size": "768x448",
      "input_reference": "https://cdn.example.com/first.jpg",
      "metadata": {
        "last_frame_url": "https://cdn.example.com/last.jpg",
        "fps": 25
      }
    }
  }
]
